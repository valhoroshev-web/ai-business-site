# Адрес сайта для canonical / sitemap
NEXT_PUBLIC_SITE_URL=https://ai-business-site-tau.vercel.app

# Индексация поисковиками: включать только после готовности сайта
SITE_READY_FOR_INDEXING=false

# Яндекс Метрика — только номер счётчика. Счётчик работает после согласия посетителя
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Заявки: пока false, форма не собирает персональные данные
LEADS_ENABLED=false

# Telegram Bot API — указывать только в Vercel Environment Variables, не в GitHub
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Данные реального оператора — перед включением заявок
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
