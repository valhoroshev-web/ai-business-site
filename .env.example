# Публичный адрес сайта для canonical / sitemap
NEXT_PUBLIC_SITE_URL=https://ai-profi.pro

# Индексацию включать только после завершения юридической подготовки
SITE_READY_FOR_INDEXING=false

# Подтверждение владения сайтом: полученные из кабинетов проверочные коды, без префиксов
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Яндекс Метрика (загружается после согласия посетителя)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Кнопки Telegram и почты с серверной CAPTCHA.
# Личные данные и секреты указывать только в Vercel Environment Variables,
# не записывать реальные значения в публичный репозиторий.
CONTACT_TELEGRAM_USERNAME=
CONTACT_EMAIL=
# Многоразовая ссылка на личный чат Яндекс Телемоста, не публиковать в репозитории
CONTACT_YANDEX_URL=
CONTACT_CAPTCHA_SECRET=

# Юридические реквизиты для утверждённой политики
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_POLICY_APPROVED=false
