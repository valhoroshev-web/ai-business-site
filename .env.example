# Адрес сайта для canonical и sitemap
NEXT_PUBLIC_SITE_URL=https://ai-business-site-tau.vercel.app

# Поисковая индексация разрешается только перед полноценным запуском
SITE_READY_FOR_INDEXING=false

# Яндекс Метрика — номер счётчика
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Приём заявок: включать после проверки доставки, защиты и юридических документов
LEADS_ENABLED=false

# Resend — получатель и API-ключ указываются ТОЛЬКО в секретах Vercel
# Если Resend настроен, отправка идёт на этот адрес, не показывая его посетителю
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Telegram Bot API — альтернативная доставка заявки в чат, только секреты Vercel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Turnstile: серверная защита + HMAC-ключ для иконок
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Данные оператора персональных данных и статус утверждённой политики
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_POLICY_APPROVED=false
